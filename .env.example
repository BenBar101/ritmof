# ─────────────────────────────────────────────────────────────────────────────
# RITMOL environment variables
# Copy this file to .env and fill in the values before running `vite build`.
# NEVER commit your real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Dropbox OAuth App Key (PKCE public-client — NOT a secret).
# Obtain from https://www.dropbox.com/developers/apps after creating an app with:
#   - Scoped access
#   - permissions: files.content.read, files.content.write
#   - Redirect URI exactly matching your deployment origin + /dropbox-callback
#     e.g. https://your-username.github.io/ritmol/dropbox-callback
# The key is intentionally inlined into the client bundle. See dropbox.js for
# the documented residual threat model. Rotate immediately if it leaks publicly.
VITE_DROPBOX_APP_KEY=your_dropbox_app_key_here

# Base path for GitHub Pages / sub-path deployments.
# Set to your repository name if deploying to https://username.github.io/reponame/
# Leave empty (or set to /) for root deployments.
# Example: VITE_BASE_PATH=/ritmol
VITE_BASE_PATH=/

# Optional: Google OAuth Client ID for Google Calendar integration.
# Obtain from https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth 2.0 Client ID → Web application.
# Add your deployment origin to "Authorised JavaScript origins".
# Leave unset to disable Google Calendar sync (the feature will show a config prompt).
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Gemini API key used by Playwright E2E tests (never commit real keys).
# Set this in your local shell or CI secrets.
GEMINI_TEST_API_KEY=
